MONGODB_URI=mongodb://127.0.0.1:27029
MONGODB_DATABASE=skill_orders_demo
# Logfire project read key; distinct from the simulator's write token.
LOGFIRE_API_KEY=
LOGFIRE_MCP_URL=https://logfire-eu.pydantic.dev/mcp
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
COMPOSIO_NOTION_CONNECTED_ACCOUNT_ID=

# Project to query in the agent phase; match the simulator write token project.
LOGFIRE_PROJECT=

# Required write token for agent traces; separate from MCP read access.
LOGFIRE_TOKEN=

# Phase 2: manual investigation. The mailbox is the receiving inbox.
OPENAI_API_KEY=
REASONING_EFFORT=low
MODEL=openai:gpt-6-luna
GMAIL_ACCOUNT_EMAIL=
NOTION_DATABASE_NAME=Incidents

# Investigator and improver have independent model settings.
IMPROVER_MODEL=openai:gpt-6.1-sol
IMPROVER_REASONING_EFFORT=high
